{
  "audience": "a strong CS undergraduate at IIT Bombay who learns fast and wants rigorous, in-depth, university-level explanations (internals, mechanisms, trade-offs, math), not beginner-friendly overviews",
  "prephub": {
    "content_dir": "~/Desktop/prep-hub/videos/content",
    "map": {"dbms": "dbms", "networks": "cn", "comp-arch": "coa", "oop": "cpp", "ml": "aiml", "llms": "aiml", "os": "os"},
    "skip_subtopics": ["courses", "oop/errors", "oop/perf", "comp-arch/ooo", "comp-arch/prefetch", "comp-arch/dram", "comp-arch/security", "dbms/bigdata"],
    "videos_per_day": 15
  },
  "daily": {
    "lectures_per_day": 3,
    "shorts_queries_per_day": 2,
    "max_shorts_per_query": 2,
    "lecture_min_sec": 300,
    "lecture_max_sec": 6000,
    "short_max_sec": 180,
    "channel_search_results": 4,
    "search_results": 25,
    "parallel_llm_calls": 3
  },
  "quality": {
    "min_each_score": 6,
    "min_avg_score": 7,
    "min_depth": 6,
    "prephub_min_depth": 4
  },
  "llm": {
    "model": "sonnet",
    "timeout_sec": 420
  },
  "transcript_languages": ["en", "en-US", "en-GB"],
  "topics": {
    "cpp": {
      "name": "C++",
      "query": "C++",
      "channels": ["CppCon", "TheCherno", "cppweekly", "MikeShah", "MeetingCPP", "LowLevelTV", "JacobSorber"]
    },
    "os": {
      "name": "Operating Systems",
      "query": "operating systems",
      "channels": ["CoreDumpped", "JacobSorber", "mitocw", "Computerphile", "nesoacademy"]
    },
    "cn": {
      "name": "Computer Networks",
      "query": "computer networks",
      "channels": ["JimKurose", "BenEater", "PracticalNetworking", "ChrisGreer", "hnasr", "Computerphile"]
    },
    "dbms": {
      "name": "DBMS",
      "query": "database",
      "channels": ["CMUDatabaseGroup", "cs186berkeley", "hnasr", "Decomplexify", "stanfordonline", "Computerphile"]
    },
    "coa": {
      "name": "Computer Architecture",
      "query": "computer architecture",
      "channels": ["OnurMutluLectures", "BenEater", "CoreDumpped", "BranchEducation", "mitocw", "MollyRocket", "Computerphile"]
    },
    "aiml": {
      "name": "AI & ML",
      "query": "machine learning",
      "channels": ["stanfordonline", "AAmini", "3blue1brown", "statquest", "AndrejKarpathy", "umarjamilai", "Eigensteve", "Mutual_Information", "SerranoAcademy", "YannicKilcher"]
    }
  },
  "syllabus_file": "syllabus.json"
}
